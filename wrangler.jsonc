// Cloudflare Workers configuration.
//
// This Worker has no script: it only serves the static files in dist/.
// Requests for static assets are free and unlimited on every plan and never
// count against the Workers request quota.
// https://developers.cloudflare.com/workers/static-assets/
{
  "name": "egemengezer-site",
  "compatibility_date": "2026-11-01",

  "assets": {
    "directory": "./dist",
    // /tr/ serves /tr/index.html; /tr redirects to /tr/.
    "html_handling": "auto-trailing-slash",
    // Unknown paths get dist/404.html with status 404.
    "not_found_handling": "404-page"
  },

  // Attach the Worker to the apex domain. Wrangler creates the DNS record;
  // any existing A/AAAA/CNAME record for the apex must be removed first.
  // MX and TXT records (Google Workspace mail) are not affected.
  "routes": [
    { "pattern": "egemengezer.com.tr", "custom_domain": true }
  ],

  // Serve only on the custom domain, not on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false
}
